# --- Server ---
PORT=5000
# Frontend origin(s) allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Local example: postgresql://postgres:password@localhost:5432/portfolio
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio
# Set to true for hosted databases that require SSL (Neon, Supabase, Render...)
DATABASE_SSL=false

# --- Auth (admin panel) ---
# Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Used only by `npm run db:seed` to create the admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# --- GitHub stats proxy ---
GITHUB_USERNAME=Roywick
# Optional: raises GitHub rate limit from 60/h to 5000/h (no scopes needed)
GITHUB_TOKEN=
