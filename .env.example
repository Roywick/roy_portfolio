# Get these from https://www.emailjs.com/ after creating a service + template
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: URL of the backend API. Leave empty in dev (Vite proxies /api to localhost:5000).
# In production set it to your deployed API, e.g. https://api.example.com/api
VITE_API_URL=
